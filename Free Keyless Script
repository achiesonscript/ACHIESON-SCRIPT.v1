-- =============================================
-- DISCORD POPUP — MATCHES IMAGE EXACTLY
-- =============================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function copyDiscordLink()
    local link = "https://discord.gg/XrtZB9KtB" -- ✅ YOUR LINK HERE
    pcall(function()
        if setclipboard then
            setclipboard(link)
            return true
        end
    end)
    return pcall(function()
        if ClipboardService then
            ClipboardService:SetText(link)
            return true
        end
    end)
end

local function showDiscordPopup()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "DiscordPopupGui"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.DisplayOrder = 1000

    pcall(function()
        screenGui.Parent = game:GetService("CoreGui")
    end)
    if not screenGui.Parent then
        screenGui.Parent = PlayerGui
    end

    -- Main Panel — matches image size & style
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 435, 0, 195)
    frame.Position = UDim2.new(0.5, -220, 0.5, -100)
    frame.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 14)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(90, 110, 255)
    stroke.Thickness = 2.5
    stroke.Parent = frame

    -- Title — corrected text
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 90)
    title.Position = UDim2.new(0, 0, 0, 10)
    title.BackgroundTransparency = 1
    title.Text = "JOINE THE DISCORD FOR UPDATED SCRIPT!"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 22
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    -- Copy Button
    local copyBtn = Instance.new("TextButton")
    copyBtn.Size = UDim2.new(0, 170, 0, 50)
    copyBtn.Position = UDim2.new(0.5, -185, 0, 115)
    copyBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    copyBtn.Text = "Copy Link"
    copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    copyBtn.Font = Enum.Font.GothamSemibold
    copyBtn.TextSize = 16
    copyBtn.Parent = frame

    local copyCorner = Instance.new("UICorner")
    copyCorner.CornerRadius = UDim.new(0, 10)
    copyCorner.Parent = copyBtn

    -- Close Button
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 170, 0, 50)
    closeBtn.Position = UDim2.new(0.5, 15, 0, 115)
    closeBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
    closeBtn.Text = "Close"
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.Font = Enum.Font.GothamSemibold
    closeBtn.TextSize = 16
    closeBtn.Parent = frame

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 10)
    closeCorner.Parent = closeBtn

    -- Button Actions
    copyBtn.Activated:Connect(function()
        if copyDiscordLink() then
            copyBtn.Text = "Copied!"
        else
            copyBtn.Text = "Copied (manual)"
        end
        task.delay(1.5, function()
            if copyBtn and copyBtn.Parent then
                copyBtn.Text = "Copy Link"
            end
        end)
    end)

    closeBtn.Activated:Connect(function()
        if screenGui and screenGui.Parent then
            screenGui:Destroy()
        end
    end)
end

-- Auto show when script runs
task.defer(function()
    task.wait(0.5)
    showDiscordPopup()
end)
